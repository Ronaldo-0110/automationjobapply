# Copy this file to .env and fill it in. Never commit .env.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification on). Do NOT use your normal Gmail password.
SENDER_EMAIL=
SENDER_APP_PASSWORD=
SENDER_NAME=
SENDER_PHONE=
SENDER_LINKEDIN=
EXPERIENCE=1 year and 4 months
RESUME_PATH=C:/path/to/your_resume.pdf
DELAY_SECONDS=20
MAX_PER_RUN=50
